{
  "mcpServers": {
    "rea": {
      "command": "node",
      "args": ["tools/rea/node_modules/rea-agents/scripts/rea.mjs", "mcp"],
      "env": {
        "REA_MCP_INPUT_SCHEMA_PROFILE": "compact"
      }
    },
    "firebase": {
      "command": "node",
      "args": [
        "tools/firebase/node_modules/firebase-tools/lib/bin/firebase.js",
        "mcp",
        "--dir",
        "."
      ]
    }
  }
}
