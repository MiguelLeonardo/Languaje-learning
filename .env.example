# Copy to backend/.env for local runs. NEVER commit real secrets.
ENV=local
DATABASE_URL=sqlite:///./languaje.db
JWT_SECRET=local-dev-only-secret-change-me-0123456789

# Speech STT (microphone) & Speaker TTS (voice synthesis) & Roleplay LLM
SPEECH_PROVIDER=mock            # mock | openai_whisper
TTS_PROVIDER=browser            # browser | openai_tts | elevenlabs
LLM_PROVIDER=mock               # mock | anthropic

# Speaker & AI API keys (optional in local; can also be connected live in the UI modal)
# OPENAI_API_KEY=sk-...
# OPENAI_TTS_VOICE=nova
# ELEVENLABS_API_KEY=xi-...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
